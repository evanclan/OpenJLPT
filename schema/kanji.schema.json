{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/evanclan/OpenJLPT/blob/main/schema/kanji.schema.json",
  "title": "OpenJLPT Kanji Entry",
  "description": "A single JLPT kanji at a given level, enriched from KANJIDIC2.",
  "type": "object",
  "required": [
    "character",
    "level",
    "strokes",
    "grade",
    "freq",
    "radical",
    "radical_number",
    "onyomi",
    "kunyomi",
    "meanings"
  ],
  "additionalProperties": false,
  "properties": {
    "character": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "description": "The kanji character (maxLength 2 allows for surrogate-pair code points)."
    },
    "level": {
      "type": "string",
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ],
      "description": "JLPT level (current N5–N1 system)."
    },
    "strokes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Stroke count (KANJIDIC2)."
    },
    "grade": {
      "type": [
        "integer",
        "null"
      ],
      "description": "School grade (1–6), 8 = other jōyō, 9–10 = jinmeiyō (KANJIDIC2)."
    },
    "freq": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Newspaper frequency rank, 1 = most frequent (KANJIDIC2)."
    },
    "radical": {
      "type": [
        "string",
        "null"
      ],
      "description": "Classical (Kangxi) radical as an ordinary character, e.g. 日."
    },
    "radical_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 214,
      "description": "Classical (Kangxi) radical number, 1–214."
    },
    "onyomi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "On'yomi readings (katakana)."
    },
    "kunyomi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kun'yomi readings (hiragana). KANJIDIC2 notation: '.' separates okurigana (た.べる), '-' marks prefix/suffix use."
    },
    "nanori": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Readings used only in names (KANJIDIC2)."
    },
    "meanings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "English meanings (KANJIDIC2, falling back to Waller)."
    },
    "words": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "OpenJLPT vocabulary words that use this kanji, easiest level first (join on vocab `word`)."
    },
    "supplementary": {
      "type": "boolean",
      "const": true,
      "description": "Present on jōyō kanji missing from Waller's (pre-2010) lists, added at the easiest level of an OpenJLPT word that uses them, otherwise N1. Filter these out for Waller's lists only."
    }
  }
}
